<?xml version="1.0"?>
<package format="3">
  <name>orion_bench</name>
  <version>0.1.0</version>
  <description>ROS 2 control-message latency bench for Orion mesh experiments</description>
  <maintainer email="ground@orion">ground</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
